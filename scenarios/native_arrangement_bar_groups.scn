# Explicit 4/4 portable Set fixture; group edits use only native controls.
settle 60
ui-zoom 1
assert snap practice-saved == true
act arrangement-bar-example
settle 8
assert snap set-cards == 4
assert snap arrangement-primary == true
assert snap arrangement-dirty == false
assert snap arrangement-groups == none
assert snap practice-saved == true
checkpoint-arrangement before
click .arrangement-bar-select @data-arrangement-bar=0
click .arrangement-bar-select @data-arrangement-bar=1
click .arrangement-bar-select @data-arrangement-bar=2
click .arrangement-bar-select @data-arrangement-bar=3
click .arrangement-group-count-input
input-text 2 + 2
assert snap arrangement-group-counts == 2 + 2
click .t-btn @data-arrangement-action=group-preview
settle 4
assert snap arrangement-group-preview == true
assert snap arrangement-dirty == false
assert snap arrangement-groups == none
checkpoint-arrangement preview
capture 01_bar_group_preview
click .t-btn @data-arrangement-action=group-cancel
settle 3
assert snap arrangement-group-preview == false
assert snap arrangement-dirty == false
assert snap arrangement-can-undo == false
click .t-btn @data-arrangement-action=group-preview
click .t-btn @data-arrangement-action=group-apply
settle 4
assert snap arrangement-groups == 2 + 2
assert snap arrangement-dirty == true
assert snap arrangement-can-undo == true
click .t-btn @data-arrangement-action=undo
settle 3
assert snap arrangement-groups == none
assert snap arrangement-dirty == false
click .t-btn @data-arrangement-action=redo
settle 3
assert snap arrangement-groups == 2 + 2
click .arrangement-save
settle 8
assert snap arrangement-dirty == false
assert snap practice-saved == true
checkpoint-arrangement saved
click .arrangement-group-count-input
input-text 1 + 3
assert snap arrangement-group-counts == 1 + 3
click .t-btn @data-arrangement-action=group-preview
settle 3
click .t-btn @data-arrangement-action=group-apply
settle 3
assert snap arrangement-groups == 2 + 2
assert snap arrangement-dirty == false
click .t-btn @data-arrangement-action=group-preview
click .t-btn @data-arrangement-action=group-choice-update
click .t-btn @data-arrangement-action=group-apply
settle 4
assert snap arrangement-groups == 1 + 3
click .t-btn @data-arrangement-action=undo
settle 3
assert snap arrangement-groups == 2 + 2
assert snap arrangement-dirty == false
checkpoint-arrangement after-undo
resize 420 1100
settle 8
assert snap arrangement-dirty == false
assert snap arrangement-group-counts == 1 + 3
capture 02_narrow_bar_groups
wheel 0 650 px on .workspace-screen
settle 5
capture 03_narrow_scene
wheel 0 -2000 px on .workspace-screen
settle 4
click .workspace-panel Practice
settle 3
assert snap arrangement-producer == false
click .workspace-panel Arrangement
settle 4
assert snap arrangement-producer == true
assert snap arrangement-groups == 2 + 2
capture 04_panel_return
