# Explicit adjacent passage -> saved target setup -> standalone approach.
settle 3
ui-zoom 0.65
act chord-approach-example
settle 3
click .pill Rehearsal
settle 3
click .chord-approach-choice Inspect from above
settle 3
click .t-btn Hear approach
settle 3
assert snap set-cards == 2
assert snap approach-cards == 0
click .t-btn Next
settle 3
click .pill Stage
settle 3
assert snap context-approaches >= 2
capture 01_approach_ambient
click .pill Rehearsal
settle 3
click .t-btn Append approach exercise
settle 3
assert snap set-cards == 3
assert snap approach-cards == 1
click .t-btn Next
settle 3
assert snap rehearsal-strings == 4
assert snap approach-descends == true
assert snap approach-sequential == true
assert text concert D
capture 02_approach_staged
click .t-btn Run
settle 10
assert snap rehearsal-running == true
click .t-btn Pause
settle 3
assert snap rehearsal-running == false
assert snap approach-sequential == true
assert snap history-observed >= 4
capture 03_approach_paused
log Chord approach seed complete
