settle 3
assert snap overview-active == true
assert snap overview-background == 1
assert snap overview-pinned == 1
assert snap overview-zoom == 1.25
assert snap overview-motion == false
assert snap overview-reduced-motion == true
assert snap set-cards == 2
capture 01_presentation_reopened
click .overview-restore Restore arrangement
settle 3
assert snap overview-zoom == 1.00
assert snap overview-background == 1
click .overview-fit Fit scene
settle 3
capture 02_restored_scene
log Mere presentation reopen complete

# Placement rules use the shared board while motion remains reduced.
click .overview-movement-toggle Show movement controls
assert snap overview-movement-controls == true
click .overview-role-anchored Return to anchor
settle 3
capture 03_anchor_before_move
click .overview-move-right Move selected right
settle 3
capture 04_anchor_returned
click .overview-role-seeded Free placement
click .overview-move-right Move selected right
settle 3
capture 05_free_placement
click .overview-role-pinned Pin in place
click .overview-move-right Move selected right
settle 3
assert snap overview-pinned == 1
assert snap overview-reduced-motion == true
capture 06_pin_refused_move
click .overview-role-pinned Pin in place
settle 3
capture 07_placement_inspector
log Shared placement roles complete
