# Fresh-process recipe restoration preserves saved timing and deleted-source provenance.
settle 3
assert snap overview-active == true
assert snap overview-context-items == 1
assert snap overview-context-recipes == 1
assert snap overview-context-links == 1
assert snap overview-recipe-source-present == false
assert snap overview-recipe-bpm == 80
assert snap overview-pinned == 1
assert snap overview-background == 1
assert snap overview-atmosphere == orbits
assert snap set-cards == 3
click .overview-inspector
settle 12
capture 01_recipe_reopened
click .overview-context-hear Hear
settle 3
assert snap set-cards == 3
click .overview-context-add
settle 3
assert snap set-cards == 4
assert snap set-last-arpeggio == true
assert snap overview-recipe-source-present == false
click .overview-fit Fit scene
click .overview-graph
settle 12
capture 02_reopened_scene
log Captured arpeggio reopen complete
