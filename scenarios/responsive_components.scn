# Run at 700 logical pixels wide. Scroll routing has retained-host tests.
settle 3
act stage-context-example
settle 3
capture 00_stage
click .workspace-panel Settings
settle 3
assert snap section == Settings
capture 01_settings
click .side-item Instrument
settle 3
capture 02_instrument_settings
click .pill Rehearsal
settle 3
assert snap section == Rehearsal
capture 03_rehearsal
log Responsive component capture complete
