# Working Set and Card navigation while its original rehearsal keeps running.
# Reuse the shipping guided-runner fixture, whose tones are admitted by the
# native bounded-cycle output path.
settle 90
ui-zoom 1
act p6-mixed-set-example
settle 5
assert snap set-cards == 3
click .rehearsal-loop-mode
click .rehearsal-loop-mode
assert snap p6-loop-mode == card
click .rehearsal-run
act p6-await-card-loop
wait 4000
assert snap rehearsal-running == true
assert snap runner-set-id == 1
click .workspace-panel Mere
settle 3
assert snap overview-active == true
click .overview-node-title Working Set 1
settle 2
click .overview-open Open view
settle 3
assert snap scope-panel == Set
assert snap runner-set-id == 1
click .scope-down
settle 3
assert snap scope-panel == Practice
assert snap working-set-id == 1
assert snap runner-set-id == 1
assert snap rehearsal-running == true
capture 01_card_occurrence_with_owner_running
click .scope-up
settle 3
assert snap scope-panel == Set
assert snap rehearsal-running == true
click .scope-up
settle 3
assert snap overview-active == true
assert snap rehearsal-running == true
click role:button @aria-label=Back: Working Set 1
settle 3
assert snap scope-panel == Set
assert snap rehearsal-running == true
click role:button @aria-label=Forward: Session overview
settle 3
assert snap overview-active == true
assert snap runner-set-id == 1
log Contextual navigation scope/history complete
