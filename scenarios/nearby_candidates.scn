# Zoom gives the expanded Stage room on display-clamped desktop windows.
settle 3
ui-zoom 0.65
settle 3
act stage-context-example
settle 3
click .set-graph-reading Arrangement: Set
settle 3
click-context-node chord:Minor@pc:9
settle 3
assert snap set-cards == 1
assert text Nearby candidates
assert text Fifth distance:
capture 01_nearby
click .stage-context-nearby-show
settle 3
assert snap set-cards == 1
capture 02_disclosed
click .stage-context-candidate
settle 3
assert snap set-cards == 1
click .t-btn Hear
settle 3
click .t-btn Add to Set
settle 3
assert snap set-cards == 2
capture 03_added
