# Explicit varying-envelope synthetic input; actual output and sealed storage.
settle 90
ui-zoom 1
assert snap practice-saved == true
act song-cache-example
act p7b-seconds-example
settle 6
act p7b-checkpoint baseline
assert text 1.125 s
click role:switch @aria-label=Select Card 2
click role:button @aria-label=Play backing
act await-selected-take-playback
wait 1800
settle 3
assert snap take-playback-observed == true
capture 01_seconds_phrase_playback
click role:button @aria-label=Stop all loops
settle 4
act p7b-retime
settle 6
act p7b-checkpoint retimed
assert text 1.125 s
capture 02_absolute_seconds_after_tempo_meter_edit
act seed-selected-envelope-capture
act verify-selected-envelope-capture
settle 8
assert snap loop-capture-references == 1
act p7a-reorder
settle 6
act p7b-checkpoint reordered
capture 03_seconds_take_follows_card
act p7b-duration-refusal
settle 4
assert text Clear the captured loop
act p7b-checkpoint duration-refused
capture 04_duration_edit_retains_captured_clock
act p7b-recover-seconds
settle 6
act wav-export-fixture
settle 8
assert text Exported
act p7b-checkpoint final
capture 05_mixed_duration_export
resize 760 900
settle 6
capture 06_medium_envelope
resize 420 1100
settle 6
capture 07_compact_envelope
wheel 0 1800 px on .hocket-recorder-surface
settle 5
capture scroll_before_select_third
click role:switch @aria-label=Select Card 3
assert snap recorder-selected-card == 3
capture 08_compact_third_card_reached
wheel 0 1800 px on .hocket-recorder-surface
settle 5
capture 08b_compact_transport_reached
click role:button @aria-label=Stop all loops
settle 3
wheel 0 -1800 px on .hocket-recorder-surface
settle 5
click role:switch @aria-label=Select Card 2
assert snap recorder-selected-card == 2
act verify-selected-envelope-capture
resize 420 720
settle 6
wheel 0 500 px on .workspace-screen
settle 5
capture 09_short_envelope
wheel 0 1800 px on .hocket-recorder-surface
settle 5
click role:switch @aria-label=Select Card 3
assert snap recorder-selected-card == 3
capture 10_short_third_card_reached
wheel 0 1800 px on .hocket-recorder-surface
settle 5
capture 10b_short_transport_reached
click role:button @aria-label=Stop all loops
settle 3
wheel 0 -1800 px on .hocket-recorder-surface
settle 5
click role:switch @aria-label=Select Card 2
assert snap recorder-selected-card == 2
resize 1180 1000
settle 6
ui-zoom 1.25
settle 6
capture 11_zoomed_envelope
ui-zoom 1
settle 5
act verify-selected-envelope-capture
log Looper followups envelope and layout seed complete
