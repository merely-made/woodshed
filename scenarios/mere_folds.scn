# Isolated sealed session. Set, catalog and processes stay authoritative.
settle 5
ui-zoom 0.8
act mere-example
click .workspace-panel Mere
settle 5
assert snap practice-saved == true
assert snap set-cards == 2
assert snap overview-folds == 0
act await-fold-save
act fold-checkpoint-expanded
capture 01_expanded
click .overview-fold-select Select members for fold
click .overview-node-title Working Set 1
click .overview-node-title Catalog exploration 1
assert snap overview-fold-selection == 2
click .overview-fold-create Fold selected
settle 4
assert snap overview-folds == 1
assert snap overview-fold-selection == 0
act await-fold-save
act fold-checkpoint-one
capture 02_one_fold
click .overview-fold-undo Undo fold
settle 3
assert snap overview-folds == 0
capture 03_undone
click .overview-fold-redo Redo fold
settle 3
assert snap overview-folds == 1
capture 04_redone
click .overview-fold-select Select members for fold
click .overview-node-title Practice history
click .overview-node-title @data-key=catalog:woodshed-catalog
assert snap overview-fold-selection == 2
click .overview-fold-create Fold selected
settle 5
assert snap overview-folds == 2
assert snap set-cards == 2
act await-fold-save
act fold-checkpoint-two
capture 05_two_folds
log Native folds saved
