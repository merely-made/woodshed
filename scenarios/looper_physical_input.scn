# Isolated actual microphone and output; no synthetic take injection.
settle 90
ui-zoom 1
assert snap practice-saved == true
act p7b-seconds-example
settle 8
click role:switch @aria-label=Select Card 2
click role:button @aria-label=Play backing
act await-selected-take-playback
wait 1800
assert snap take-playback-observed == true
capture 01_backing_before_microphone
click role:switch @aria-label=Record
wait 15000
capture 02_live_input_recording
click role:button @aria-label=Stop all loops
settle 15
assert snap output-capture-invalid == false
assert snap loop-capture-references >= 1
assert snap loop-capture-frames >= 1
assert snap loop-active-captures >= 1
assert snap capture-input-rate == 48000
assert snap practice-saved == true
act wav-export-fixture
settle 8
assert text Exported
capture 03_actual_microphone_take_saved
log Physical microphone recording and actual output complete
