+#[test]
+fn document_extent_clips_only_the_bounded_axis() {
+    for (overflow, expected) in [
+        ("overflow-x:clip;overflow-y:visible;", (0.0, 600.0)),
+        ("overflow-x:visible;overflow-y:clip;", (600.0, 0.0)),
