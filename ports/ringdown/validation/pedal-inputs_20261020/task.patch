+    fn launched(&mut self) {
+        let multi = self.windows.multi.as_ref().unwrap();
+        self.readings.windows = multi.windows().count();
+        self.readings.sizes = multi
+            .windows()
+            .filter_map(|id| multi.slot(id).map(|w| w.s.layout_size))
+            .collect();
