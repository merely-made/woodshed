+    /// transform is the only thing that carries zoom into its coordinates.
+    pub fn scaled_a11y_tree(&mut self) -> accesskit::TreeUpdate {
+        let layout_scale = self.host.layout_scale();
+        let (mut tree, _) = self.a11y_tree();
