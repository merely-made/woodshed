assert snap midi-attempted == 0
act midi-checkpoint configured
capture 01_configured_no_sends
click role:combobox @aria-label=MIDI output
click role:option Pedal acceptance receiver
act midi-dwell 300
wait 100000
assert snap midi-ready == true
click .t-btn Trigger Effect Next
act midi-dwell 400
wait 100000
assert snap pedal-outcome == accepted
assert snap midi-accepted == 2
click .t-btn Trigger Effect Previous
act midi-dwell 400
wait 100000
assert snap midi-accepted == 4
act midi-checkpoint ui-triggers
capture 02_ui_triggers
click role:combobox @aria-label=MIDI output
click role:option None
settle 3
act midi-checkpoint closed
capture 03_closed_saved
