# Fixture: runner-generated synthetic transcript; 960x640. The local VTT response
# is delayed two seconds. This wait must include product IO, not merely playback buffering.
wait 300
assert snap item-id == mesquite-transcript
act pane:notes
settle 2
assert text Save transcript offline
capture transcript-before-fetch
# The semantic selector resolves the shipping button through the host projection.
click role:button Save transcript offline (language unspecified)
wait 300
assert text Transcript snapshot
assert text Mesquite fixture first sentence.
assert text Mesquite fixture second sentence.
capture transcript-after-quiescence
click role:button Seek transcript to 0:05: Mesquite fixture second sentence.
wait 300
assert snap position-ms == 5000
capture transcript-cue-seek
log mesquite delayed transcript complete
