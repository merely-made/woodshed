# Fixture: local-playing. The pass-2 states, photographed through named acts.
settle 30
act tab:listen
settle 10
capture listen-menus-shut

act menu:queue:local-stereo
settle 10
capture listen-menu-open
# One menu at a time: opening a note's menu closes the queue's.
act menu:note:note-a
settle 10
capture note-menu-open
act menu:none
settle 5

act pane:notes
settle 10
capture listen-pane-notes
act pane:queue
settle 5

act tab:notes
settle 15
capture notes-cluster-open
act cluster:460
settle 10
capture notes-cluster-collapsed
act cluster:460
settle 10

act tab:mere
settle 15
capture mere-unpinned
act pin:local-stereo
settle 10
capture mere-pinned
act pin:local-stereo

act tab:settings
act resume:saved
settle 10
capture settings-resume-saved
act resume:start
log design_completions complete
