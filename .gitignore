/target
# Nested workspaces (ports/redshank) build into their own target dir.
/ports/*/target
/validation/*/target
/dist
/.cargo/config.toml
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# sem (Ataraxy-Labs) semantic-diff index cache — local, never committed.
.sem/

# Receipt output is retained outside the repository. Keep the standalone
# compatibility instrument versioned while excluding new validation packets.
/validation/*_20*/
/validation/results/
/design_docs/receipts/
/docs/receipts/
/ports/hocket/design_docs/receipts/
/ports/ringdown/validation/
/ports/redshank/receipts/
/ports/redshank/scenarios/validation/

# The block guest's WIT world, copied from graphshell-endpoint by woodshed-notation's build script.
/crates/woodshed-notation/wit/
# Not tracked: what cargo resolved is a git note on each commit (scripts/record-resolved.sh).
Cargo.lock
