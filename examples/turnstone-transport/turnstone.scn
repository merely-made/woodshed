# Open a live document tile in Turnstone's native Workbench.
settle 20
key escape
open ${WOODSHED_PANE_URL}
settle 45
act Open node in Workbench
settle 30
act Open Inspector pane
settle 10
act Maximize pane
settle 15
click surface:inspector role:button Change viewer
settle 15
click surface:inspector role:radio Genet (Bole)
settle 45
assert row Viewer: genet.scripted
act Close pane
settle 12
act Open node in Workbench
settle 15
assert wb-cells == 1
assert wb-cell Woodshed Transport
act Maximize pane
settle 30
assert maximized
assert snap browser-current-engine == genet.scripted
assert snap browser-current-content == live

# Client pixels in the 1024x600 native scenario window.
click-at 124 453
settle 35
move-at 880 285
capture 01_transport_attached
click-at 310 363
settle 35
click-at 490 363
settle 35
click-at 130 363
settle 35
click-at 714 361
settle 35
move-at 880 285
capture 02_transport_paused_with_gain
click-at 310 363
settle 35
move-at 880 285
capture 03_transport_resumed
click-at 310 453
settle 35
move-at 880 285
capture 04_transport_returned
log Woodshed transport controls exercised through native Workbench pointer input.
